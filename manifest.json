{
  "name": "Lactate & Power Test",
  "version": "1.9",
  "author": "Joaquin Pérez & Oscar Muñoz Ferriz",
  "description": "Guided LT1/LT2 lactate & Power Test",
  "type": "feature",
  "usage": "workout",
  "modificationTime": 1785484800,
  "in": [
    {
      "name": "HeartRate",
      "source": "/Activity/Move/-1/HeartRate/Current",
      "type": "subscribe"
    },
    {
      "name": "Speed",
      "source": "/Activity/Current/Speed",
      "type": "subscribe"
    },
    {
      "name": "Power",
      "source": "/Activity/Current/Power3s",
      "type": "subscribe"
    },
    {
      "name": "MaxHR",
      "source": "/Settings/User/MaxHR",
      "type": "get"
    },
    {
      "name": "LocalTime",
      "source": "/Dev/Time/LocalTime",
      "type": "get"
    }
  ],
  "out": [
    {
      "name": "lt1HR"
    },
    {
      "name": "lt2HR"
    },
    {
      "name": "lt1Pace"
    },
    {
      "name": "lt2Pace"
    },
    {
      "name": "lt2Power"
    },
    {
      "name": "hrTargetNum",
      "log": false,
      "shownName": "HR Target Range"
    },
    {
      "name": "stateNum",
      "log": false,
      "shownName": "State Index"
    },
    {
      "name": "timeRemaining",
      "log": false,
      "shownName": "Time Remaining"
    },
    {
      "name": "testModeNum",
      "log": false,
      "shownName": "Test Mode"
    },
    {
      "name": "dfaCurrent",
      "log": false,
      "shownName": "Current DFA a1"
    },
    {
      "name": "hrZoneNum",
      "log": false,
      "shownName": "HR Zone Index"
    },
    {
      "name": "countdown",
      "log": false,
      "shownName": "Countdown Start"
    }
  ],
  "template": [
    {
      "name": "t.html"
    },
    {
      "name": "debug.html"
    },
    {
      "name": "results.html"
    },
    {
      "name": "alert.html"
    },
    {
      "name": "countdown.html"
    }
  ],
  "variables": [
    {
      "shownName": "Last test date",
      "path": "lastTestDate",
      "type": "string"
    },
    {
      "shownName": "Last LT1 HR [bpm]",
      "path": "lastLt1HR",
      "type": "int"
    },
    {
      "shownName": "Last LT1 pace",
      "path": "lastLt1Pace",
      "type": "string"
    },
    {
      "shownName": "Last LT2 HR [bpm]",
      "path": "lastLt2HR",
      "type": "int"
    },
    {
      "shownName": "Last LT2 pace",
      "path": "lastLt2Pace",
      "type": "string"
    },
    {
      "shownName": "Last LT2 power [W]",
      "path": "lastLt2Power",
      "type": "int"
    }
  ]
}
